generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model User {
  id             String     @id @default(cuid())
  name           String?
  email          String     @unique
  emailVerified  DateTime?
  image          String?
  passwordHash   String
  role           String     @default("CSR_AGENT") @db.NVarChar(30)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  status         String     @default("ACTIVE") @db.NVarChar(30)
  accounts       Account[]
  attempts       Attempt[]
  auditLogs      AuditLog[]
  assignedOrders Order[]    @relation("AssignedOrders")
  sessions       Session[]
  sentMessages   ChatMessage[] @relation("SentMessages")
  receivedMessages ChatMessage[] @relation("ReceivedMessages")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Order {
  id               String    @id @default(cuid())
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  orderDate        DateTime  @default(now())
  customerName     String
  mobileNumber     String
  productsJson     String
  quantity         Int       @default(1)
  city             String
  address          String
  codAmount        Decimal   @db.Decimal(18, 2)
  remarks          String?
  status           String    @default("ACTIVE") @db.NVarChar(30)
  assignedToId     String?
  confirmationDate DateTime?
  dispatchDate     DateTime?
  attempts         Attempt[]
  assignedTo       User?     @relation("AssignedOrders", fields: [assignedToId], references: [id], onUpdate: NoAction)

  @@index([assignedToId])
  @@index([status])
  @@index([createdAt])
}

model Attempt {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())
  attemptNumber Int
  result        String   @db.NVarChar(30)
  reason        String?
  orderId       String
  agentId       String?
  agent         User?    @relation(fields: [agentId], references: [id], onUpdate: NoAction)
  order         Order    @relation(fields: [orderId], references: [id], onUpdate: NoAction)
}

model AuditLog {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  actorId     String?
  action      String
  entity      String
  entityId    String
  changesJson String
  actor       User?    @relation(fields: [actorId], references: [id])
}

model ApiConfig {
  id                 String   @id @default(cuid())
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  name               String
  loginUrl           String?
  fetchOrdersUrl     String?
  updateOrderUrl     String?
  fieldMappingJson   String?
  pollingIntervalSec Int      @default(60)
  enabled            Boolean  @default(false)
}

model ChatMessage {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  content   String
  senderId  String
  receiverId String?
  isRead    Boolean  @default(false)
  messageType String @default("TEXT") @db.NVarChar(20) // TEXT, SYSTEM, NOTIFICATION
  attachments String? // JSON string for file attachments
  sender    User     @relation("SentMessages", fields: [senderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  receiver  User?    @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([senderId])
  @@index([receiverId])
  @@index([createdAt])
}
