# ========================================
# PRODUCTION ENVIRONMENT CONFIGURATION
# ========================================
# Copy this file to .env.production and fill in your actual values
# DO NOT commit .env.production to Git!

# ========================================
# DATABASE CONFIGURATION (SQL Server)
# ========================================
# Get these credentials from your SmartASP control panel
DATABASE_URL="sqlserver://YOUR_SMARTASP_SQL_HOST:1433;database=YOUR_DB_NAME;user=YOUR_DB_USER;password=YOUR_DB_PASSWORD;encrypt=true;trustServerCertificate=true"

# Example:
# DATABASE_URL="sqlserver://sql.smartasp.net:1433;database=darjaah_csr;user=darjaah_user;password=SecurePassword123!;encrypt=true;trustServerCertificate=true"

# ========================================
# NEXTAUTH CONFIGURATION
# ========================================
# Your production domain (must match exactly)
NEXTAUTH_URL="https://your-domain.smartasp.net"

# Generate a new secret for production using:
# openssl rand -base64 32
# Or visit: https://generate-secret.vercel.app/32
NEXTAUTH_SECRET="GENERATE_A_SECURE_RANDOM_STRING_HERE_32_CHARACTERS_MINIMUM"

# Example:
# NEXTAUTH_SECRET="8f2k9j3n4m5b6v7c8x9z0a1s2d3f4g5h6j7k8l9p0"

# ========================================
# NODE ENVIRONMENT
# ========================================
NODE_ENV="production"

# ========================================
# SERVER CONFIGURATION
# ========================================
# Port for the application (default: 3000)
PORT=3000

# Host binding (0.0.0.0 allows external connections)
HOST=0.0.0.0

# ========================================
# SOCKET.IO CONFIGURATION
# ========================================
# Socket.IO will run on the same port as the app
SOCKET_PORT=3000
SOCKET_PATH="/socket.io"

# ========================================
# CORS CONFIGURATION
# ========================================
# Add your production domain for CORS
CORS_ORIGIN="https://your-domain.smartasp.net"

# ========================================
# LOGGING CONFIGURATION
# ========================================
# Log level (error, warn, info, debug)
LOG_LEVEL="info"

# Enable/disable verbose logging
VERBOSE_LOGGING="false"

# ========================================
# FILE UPLOAD CONFIGURATION
# ========================================
# Maximum file upload size (in bytes)
# Default: 10MB
MAX_FILE_SIZE=10485760

# Allowed file types
ALLOWED_FILE_TYPES="image/jpeg,image/png,image/gif,image/webp,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,text/plain"

# ========================================
# ADDITIONAL NOTES
# ========================================
# 1. Never commit .env.production to version control
# 2. Keep your NEXTAUTH_SECRET secure and unique
# 3. Ensure DATABASE_URL points to production SQL Server
# 4. Update NEXTAUTH_URL with your actual domain
# 5. Test all configurations before going live
# ========================================



